# Set these in the Netlify UI (Project configuration → Environment variables).
# For local development with `netlify dev`, you can copy this file to .env.

# Password required to log into /admin.html and use the content API's write routes.
# Admin login is disabled until this is set.
ADMIN_PASSWORD=changeme

# Used to sign the login session cookie. Set this to a long random string.
SESSION_SECRET=change-this-to-a-long-random-string
