# Copy this file to .env (or set these as real environment variables on your host)
# and load it before starting the server — e.g. with the `dotenv` package,
# or by exporting them in your shell / hosting platform's environment settings.

# Password required to log into /admin.html and use the content API's write routes.
ADMIN_PASSWORD=changeme

# Used to sign the login session cookie. Set this to a long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on (most hosts set this for you automatically).
PORT=3000
